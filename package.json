{
  "name": "firefox-tab-router",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Route links to native Firefox tab groups using local URL rules.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:firefox": "node scripts/test-firefox.mjs",
    "lint": "web-ext lint --source-dir extension --warnings-as-errors",
    "build": "web-ext build --source-dir extension --artifacts-dir artifacts --overwrite-dest",
    "start": "web-ext run --source-dir extension",
    "sign": "web-ext sign --source-dir extension --artifacts-dir artifacts --channel unlisted",
    "check": "npm test && npm run lint"
  },
  "devDependencies": {
    "web-ext": "10.8.0"
  }
}
